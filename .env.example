# App connection: a role WITHOUT superuser or BYPASSRLS, so row-level security applies.
DATABASE_URL=postgres://sylken_app:change-me@localhost:5432/sylken
# Schema owner, used only by `npm run migrate`.
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/sylken
# Password given to the sylken_app role the first time migrations create it.
APP_DB_PASSWORD=change-me
PORT=3000
NODE_ENV=production
# Key that encrypts sensitive fields (from security section 2). 32 random bytes, base64:
#   openssl rand -base64 32
# Keep a copy somewhere safe and separate from database backups. If unset, data/sylken.key is created and used.
SYLKEN_DATA_KEY=
# Set to 1 only when the app sits behind a proxy (Caddy) that sets X-Forwarded-For.
TRUST_PROXY=

# Backups (docs/backup.md). Key that encrypts every backup: 32 random bytes, base64 (openssl rand -base64 32).
# Make it once, never change it, and keep a copy away from this computer: without it backups cannot be read.
SYLKEN_BACKUP_KEY=
# Where backups are kept (default: sylken-backups in your home folder) and a second place to copy each one to,
# such as a USB drive or a synced folder, so a backup survives this computer.
SYLKEN_BACKUP_DIR=
SYLKEN_BACKUP_COPY_DIR=
